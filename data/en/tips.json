{
 "tips": [
  {
   "id": "to-two",
   "title": "to의 두 가지 뜻",
   "see": {
    "item": "to"
   }
  },
  {
   "id": "want-thing",
   "title": "want + 물건 vs want to + 동작",
   "body": [
    [
     {
      "lang": "en",
      "text": "want"
     },
     {
      "lang": "ko",
      "text": " 뒤에 물건이 오면 '그걸 갖고 싶어'예요. "
     },
     {
      "lang": "en",
      "text": "I want water."
     }
    ],
    [
     {
      "lang": "en",
      "text": "want to"
     },
     {
      "lang": "ko",
      "text": " 뒤에 동작이 오면 '그걸 하고 싶어'예요. "
     },
     {
      "lang": "en",
      "text": "I want to drink."
     }
    ],
    [
     {
      "lang": "en",
      "text": "to"
     },
     {
      "lang": "ko",
      "text": "가 있으면 동작, 없으면 물건이라고 기억해요."
     }
    ]
   ],
   "words": {
    "i": {
     "ko_pron": "아이",
     "meaning": "나"
    },
    "want": {
     "ko_pron": "원트",
     "meaning": "원하다"
    },
    "to": {
     "ko_pron": "투",
     "meaning": "~하기를 (want to = ~하고 싶다)"
    },
    "water": {
     "ko_pron": "워터",
     "meaning": "물"
    },
    "a": {
     "ko_pron": "어",
     "meaning": "하나의 (셀 수 있는 것 앞에)"
    },
    "cookie": {
     "ko_pron": "쿠키",
     "meaning": "쿠키"
    }
   },
   "examples": [
    {
     "text": "I want [water].",
     "ko_pron": "아이 원트 워터.",
     "meaning": "물 줘. (물을 원해)"
    },
    {
     "text": "I want [to drink] water.",
     "ko_pron": "아이 원 투 드링크 워터.",
     "meaning": "물 마시고 싶어.",
     "words": {
      "drink": {
       "ko_pron": "드링크",
       "meaning": "마시다"
      }
     }
    },
    {
     "text": "I want [a cookie].",
     "ko_pron": "아이 원트 어 쿠키.",
     "meaning": "쿠키 갖고 싶어."
    },
    {
     "text": "I want [to eat] a cookie.",
     "ko_pron": "아이 원 투 잇 어 쿠키.",
     "meaning": "쿠키 먹고 싶어.",
     "words": {
      "eat": {
       "ko_pron": "잇",
       "meaning": "먹다"
      }
     }
    }
   ]
  },
  {
   "id": "fast-speech",
   "title": "빨리 말하면 이렇게 들려요",
   "body": [
    [
     {
      "lang": "ko",
      "text": "원어민은 붙은 말을 빨리 이어서 말해요. 글자는 그대로예요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "want to"
     },
     {
      "lang": "ko",
      "text": "는 '워너', "
     },
     {
      "lang": "en",
      "text": "going to"
     },
     {
      "lang": "ko",
      "text": "는 '고너'처럼 들려요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "have to"
     },
     {
      "lang": "ko",
      "text": "는 '해프터', "
     },
     {
      "lang": "en",
      "text": "got to"
     },
     {
      "lang": "ko",
      "text": "는 '가러'처럼 들려요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "Could you"
     },
     {
      "lang": "ko",
      "text": "는 '쿠쥬'처럼 들려요. 두 소리가 만나 '쥬'가 돼요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "줄여 쓴 "
     },
     {
      "lang": "en",
      "text": "wanna"
     },
     {
      "lang": "ko",
      "text": ", "
     },
     {
      "lang": "en",
      "text": "gonna"
     },
     {
      "lang": "ko",
      "text": "는 말할 때만 쓰고, 글로 쓸 때는 원래 모양으로 써요."
     }
    ]
   ],
   "words": {
    "i": {
     "ko_pron": "아이",
     "meaning": "나"
    },
    "to": {
     "ko_pron": "투 (빨리 말하면 '터, 너')",
     "meaning": "~하기를"
    },
    "go": {
     "ko_pron": "고",
     "meaning": "가다"
    }
   },
   "examples": [
    {
     "text": "I [want to] go home.",
     "ko_pron": "아이 워너 고 홈.",
     "meaning": "집에 가고 싶어.",
     "words": {
      "want": {
       "ko_pron": "원트",
       "meaning": "원하다 (want to → 워너)"
      },
      "home": {
       "ko_pron": "홈",
       "meaning": "집으로"
      }
     }
    },
    {
     "text": "I'm [going to] eat.",
     "ko_pron": "아임 고너 잇.",
     "meaning": "먹을 거야.",
     "words": {
      "i'm": {
       "ko_pron": "아임",
       "meaning": "나는 ~이다 (I am의 줄임)"
      },
      "going": {
       "ko_pron": "고잉",
       "meaning": "~할 거야 (going to → 고너)"
      },
      "eat": {
       "ko_pron": "잇",
       "meaning": "먹다"
      }
     }
    },
    {
     "text": "I [have to] go.",
     "ko_pron": "아이 해프터 고.",
     "meaning": "가야 해.",
     "words": {
      "have": {
       "ko_pron": "해브",
       "meaning": "~해야 한다 (have to → 해프터)"
      }
     }
    },
    {
     "text": "I've [got to] go.",
     "ko_pron": "아이브 가러 고.",
     "meaning": "가야 해.",
     "words": {
      "i've": {
       "ko_pron": "아이브",
       "meaning": "나는 ~했다 (I have의 줄임)"
      },
      "got": {
       "ko_pron": "갓",
       "meaning": "~해야 한다 (got to → 가러)"
      }
     }
    },
    {
     "text": "[Could you] help me?",
     "ko_pron": "쿠쥬 헬프 미?",
     "meaning": "도와주실 수 있어요?",
     "words": {
      "could": {
       "ko_pron": "쿠드",
       "meaning": "~해 줄 수 있다 (공손하게)"
      },
      "you": {
       "ko_pron": "유",
       "meaning": "너, 당신 (Could you → 쿠쥬)"
      },
      "help": {
       "ko_pron": "헬프",
       "meaning": "돕다"
      },
      "me": {
       "ko_pron": "미",
       "meaning": "나를"
      }
     }
    }
   ]
  },
  {
   "id": "a-the",
   "title": "a와 the 구분",
   "see": {
    "compare": "a-the"
   }
  },
  {
   "id": "polite",
   "title": "공손함 정도: Can I < Could I < May I",
   "body": [
    [
     {
      "lang": "ko",
      "text": "부탁하는 말도 공손한 정도가 달라요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "Can I"
     },
     {
      "lang": "ko",
      "text": "보다 "
     },
     {
      "lang": "en",
      "text": "Could I"
     },
     {
      "lang": "ko",
      "text": ", 그보다 "
     },
     {
      "lang": "en",
      "text": "May I"
     },
     {
      "lang": "ko",
      "text": "가 더 공손해요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "Can I"
     },
     {
      "lang": "ko",
      "text": "는 친구·가족에게, "
     },
     {
      "lang": "en",
      "text": "Could I"
     },
     {
      "lang": "ko",
      "text": "는 가게·식당에서, "
     },
     {
      "lang": "en",
      "text": "May I"
     },
     {
      "lang": "ko",
      "text": "는 아주 정중하게 써요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "남에게 해 달라고 할 때도 같아요. "
     },
     {
      "lang": "en",
      "text": "Can you"
     },
     {
      "lang": "ko",
      "text": "보다 "
     },
     {
      "lang": "en",
      "text": "Could you"
     },
     {
      "lang": "ko",
      "text": "가 공손해요."
     }
    ]
   ],
   "words": {
    "i": {
     "ko_pron": "아이",
     "meaning": "나"
    },
    "have": {
     "ko_pron": "해브",
     "meaning": "받다, 먹다"
    },
    "water": {
     "ko_pron": "워터",
     "meaning": "물"
    }
   },
   "examples": [
    {
     "text": "[Can I] have water?",
     "ko_pron": "캔 아이 해브 워터?",
     "meaning": "물 좀 줄래?",
     "words": {
      "can": {
       "ko_pron": "캔",
       "meaning": "~해도 되다 (편하게)"
      }
     }
    },
    {
     "text": "[Could I] have water?",
     "ko_pron": "쿠드 아이 해브 워터?",
     "meaning": "물 좀 주시겠어요?",
     "words": {
      "could": {
       "ko_pron": "쿠드",
       "meaning": "~해도 될까요 (Can보다 공손)"
      }
     }
    },
    {
     "text": "[May I] have water?",
     "ko_pron": "메이 아이 해브 워터?",
     "meaning": "물을 주실 수 있을까요?",
     "words": {
      "may": {
       "ko_pron": "메이",
       "meaning": "~해도 될까요 (가장 공손)"
      }
     }
    },
    {
     "text": "[Could you] help me?",
     "ko_pron": "쿠드 유 헬프 미?",
     "meaning": "도와주시겠어요?",
     "words": {
      "could": {
       "ko_pron": "쿠드",
       "meaning": "~해 주시겠어요 (Can you보다 공손)"
      },
      "you": {
       "ko_pron": "유",
       "meaning": "당신"
      },
      "help": {
       "ko_pron": "헬프",
       "meaning": "돕다"
      },
      "me": {
       "ko_pron": "미",
       "meaning": "나를"
      }
     }
    }
   ]
  },
  {
   "id": "ing-now",
   "title": "I'm ___ing는 지금 하는 중",
   "body": [
    [
     {
      "lang": "en",
      "text": "I'm"
     },
     {
      "lang": "ko",
      "text": " 뒤에 동작과 "
     },
     {
      "lang": "en",
      "text": "ing"
     },
     {
      "lang": "ko",
      "text": "가 오면 '지금 ~하는 중이야'예요."
     }
    ],
    [
     {
      "lang": "en",
      "text": "I eat"
     },
     {
      "lang": "ko",
      "text": "은 '나는 평소에 먹어', "
     },
     {
      "lang": "en",
      "text": "I'm eating"
     },
     {
      "lang": "ko",
      "text": "은 '지금 먹는 중이야'예요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "전화나 문자로 지금 뭐 하는지 말할 때 많이 써요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "동작 끝에 "
     },
     {
      "lang": "en",
      "text": "ing"
     },
     {
      "lang": "ko",
      "text": "를 붙여요. "
     },
     {
      "lang": "en",
      "text": "eat"
     },
     {
      "lang": "ko",
      "text": "은 "
     },
     {
      "lang": "en",
      "text": "eating"
     },
     {
      "lang": "ko",
      "text": ", "
     },
     {
      "lang": "en",
      "text": "play"
     },
     {
      "lang": "ko",
      "text": "는 "
     },
     {
      "lang": "en",
      "text": "playing"
     },
     {
      "lang": "ko",
      "text": "."
     }
    ]
   ],
   "words": {
    "i": {
     "ko_pron": "아이",
     "meaning": "나"
    },
    "i'm": {
     "ko_pron": "아임",
     "meaning": "나는 ~하는 중이다 (I am의 줄임)"
    },
    "rice": {
     "ko_pron": "라이스",
     "meaning": "밥, 쌀"
    }
   },
   "examples": [
    {
     "text": "I [eat] rice.",
     "ko_pron": "아이 잇 라이스.",
     "meaning": "나는 (평소에) 밥을 먹어.",
     "words": {
      "eat": {
       "ko_pron": "잇",
       "meaning": "먹다"
      }
     }
    },
    {
     "text": "I'm [eating] rice.",
     "ko_pron": "아임 이팅 라이스.",
     "meaning": "지금 밥 먹는 중이야.",
     "words": {
      "eating": {
       "ko_pron": "이팅",
       "meaning": "먹는 중 (eat + ing)"
      }
     }
    },
    {
     "text": "I'm [playing].",
     "ko_pron": "아임 플레잉.",
     "meaning": "지금 노는 중이야.",
     "words": {
      "playing": {
       "ko_pron": "플레잉",
       "meaning": "노는 중 (play + ing)"
      }
     }
    },
    {
     "text": "I'm [coming]!",
     "ko_pron": "아임 커밍!",
     "meaning": "지금 가고 있어!",
     "words": {
      "coming": {
       "ko_pron": "커밍",
       "meaning": "가는 중 (상대 쪽으로 갈 때는 come)"
      }
     }
    }
   ]
  }
 ]
}
