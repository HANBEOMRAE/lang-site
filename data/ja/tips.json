{
 "tips": [
  {
   "id": "polite",
   "title": "공손한 말: ございます·です·ます",
   "body": [
    [
     {
      "lang": "ja",
      "text": "おはよう"
     },
     {
      "lang": "ko",
      "text": "는 친구·가족에게, "
     },
     {
      "lang": "ja",
      "text": "おはよう ございます"
     },
     {
      "lang": "ko",
      "text": "는 선생님·어른에게 해요."
     }
    ],
    [
     {
      "lang": "ja",
      "text": "ありがとう"
     },
     {
      "lang": "ko",
      "text": "도 "
     },
     {
      "lang": "ja",
      "text": "ございます"
     },
     {
      "lang": "ko",
      "text": "를 붙이면 공손해져요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "어른에게 하는 공손한 말은 끝이 "
     },
     {
      "lang": "ja",
      "text": "です"
     },
     {
      "lang": "ko",
      "text": "나 "
     },
     {
      "lang": "ja",
      "text": "ます"
     },
     {
      "lang": "ko",
      "text": "로 끝나요."
     }
    ]
   ],
   "examples": [
    {
     "text": "おはよう [ございます]。",
     "ko_pron": "오하요- 고자이마스.",
     "meaning": "좋은 아침입니다."
    },
    {
     "text": "ありがとう [ございます]。",
     "ko_pron": "아리가토- 고자이마스.",
     "meaning": "고맙습니다."
    }
   ]
  },
  {
   "id": "sumimasen",
   "title": "すみません과 ごめんなさい",
   "body": [
    [
     {
      "lang": "ja",
      "text": "ごめんなさい"
     },
     {
      "lang": "ko",
      "text": "는 친구·가족에게 하는 '미안해'예요."
