    [
     {
      "lang": "ja",
      "text": "すみません"
     },
     {
      "lang": "ko",
      "text": "은 어른에게 '죄송해요', 그리고 사람을 부를 때 '저기요'로도 써요."
     }
    ],
    [
     {
      "lang": "ko",
      "text": "대답은 "
     },
