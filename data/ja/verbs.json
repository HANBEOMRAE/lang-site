{
  "groups": [
    { "id": "g1", "name": "1형 (5단 동사)", "desc": "끝이 う·く·ぐ·す·つ·ぬ·ぶ·む·る 로 끝나는 동사" },
    { "id": "g2", "name": "2형 (1단 동사)", "desc": "끝이 いる·える 로 끝나는 동사" },
    { "id": "g3", "name": "3형 (불규칙 동사)", "desc": "する, くる 두 개뿐" }
  ],
  "forms": [
    { "id": "masu", "name": "ます형", "desc": "공손하게 말할 때" },
    { "id": "te",   "name": "て형",   "desc": "~하고, ~해서, ~해 줘" },
    { "id": "ta",   "name": "た형",   "desc": "~했다 (지난 일)" },
    { "id": "nai",  "name": "ない형", "desc": "~안 한다" },
    { "id": "tai",  "name": "たい형", "desc": "~하고 싶다" }
  ],
  "verbs": [
    {
      "id": "kau",
      "group": "g1",
      "text": "かう",
      "kanji": "買う",
      "ko_pron": "카우",
      "meaning": "사다",
      "note": "う로 끝나는 1형: て형은 って",
      "forms": {
        "masu": { "text": "かいます", "ko_pron": "카이마스", "meaning": "삽니다" },
        "te":   { "text": "かって",   "ko_pron": "캇테",     "meaning": "사고 / 사서" },
        "ta":   { "text": "かった",   "ko_pron": "캇타",     "meaning": "샀다" },
        "nai":  { "text": "かわない", "ko_pron": "카와나이", "meaning": "안 산다" },
        "tai":  { "text": "かいたい", "ko_pron": "카이타이", "meaning": "사고 싶다" }
      },
      "example": { "text": "パンを かいます。", "ko_pron": "판오 카이마스.", "meaning": "빵을 사요." }
    },
    {
      "id": "matsu",
      "group": "g1",
      "text": "まつ",
      "kanji": "待つ",
      "ko_pron": "마츠",
      "meaning": "기다리다",
      "note": "つ로 끝나는 1형: て형은 って",
      "forms": {
        "masu": { "text": "まちます", "ko_pron": "마치마스", "meaning": "기다립니다" },
        "te":   { "text": "まって",   "ko_pron": "맛테",     "meaning": "기다리고 / 기다려서" },
        "ta":   { "text": "まった",   "ko_pron": "맛타",     "meaning": "기다렸다" },
        "nai":  { "text": "またない", "ko_pron": "마타나이", "meaning": "안 기다린다" },
        "tai":  { "text": "まちたい", "ko_pron": "마치타이", "meaning": "기다리고 싶다" }
      },
      "example": { "text": "ちょっと まって。", "ko_pron": "춋토 맛테.", "meaning": "잠깐 기다려." }
    },
    {
      "id": "kaeru",
      "group": "g1",
      "text": "かえる",
      "kanji": "帰る",
      "ko_pron": "카에루",
      "meaning": "돌아가다",
      "note": "る로 끝나지만 1형: て형은 って (2형처럼 て가 아님)",
      "forms": {
        "masu": { "text": "かえります", "ko_pron": "카에리마스", "meaning": "돌아갑니다" },
        "te":   { "text": "かえって",   "ko_pron": "카엣테",     "meaning": "돌아가고 / 돌아가서" },
        "ta":   { "text": "かえった",   "ko_pron": "카엣타",     "meaning": "돌아갔다" },
        "nai":  { "text": "かえらない", "ko_pron": "카에라나이", "meaning": "안 돌아간다" },
        "tai":  { "text": "かえりたい", "ko_pron": "카에리타이", "meaning": "돌아가고 싶다" }
      },
      "example": { "text": "いえに かえります。", "ko_pron": "이에니 카에리마스.", "meaning": "집에 돌아가요." }
    },
    {
      "id": "nomu",
      "group": "g1",
      "text": "のむ",
      "kanji": "飲む",
      "ko_pron": "노무",
      "meaning": "마시다",
      "note": "む로 끝나는 1형: て형은 んで",
      "forms": {
        "masu": { "text": "のみます", "ko_pron": "노미마스", "meaning": "마십니다" },
        "te":   { "text": "のんで",   "ko_pron": "논데",     "meaning": "마시고 / 마셔서" },
        "ta":   { "text": "のんだ",   "ko_pron": "논다",     "meaning": "마셨다" },
        "nai":  { "text": "のまない", "ko_pron": "노마나이", "meaning": "안 마신다" },
        "tai":  { "text": "のみたい", "ko_pron": "노미타이", "meaning": "마시고 싶다" }
      },
      "example": { "text": "みずを のみます。", "ko_pron": "미즈오 노미마스.", "meaning": "물을 마셔요." }
    },
    {
      "id": "yomu",
      "group": "g1",
      "text": "よむ",
      "kanji": "読む",
      "ko_pron": "요무",
      "meaning": "읽다",
      "note": "む로 끝나는 1형: て형은 んで",
      "forms": {
        "masu": { "text": "よみます", "ko_pron": "요미마스", "meaning": "읽습니다" },
        "te":   { "text": "よんで",   "ko_pron": "욘데",     "meaning": "읽고 / 읽어서" },
        "ta":   { "text": "よんだ",   "ko_pron": "욘다",     "meaning": "읽었다" },
        "nai":  { "text": "よまない", "ko_pron": "요마나이", "meaning": "안 읽는다" },
        "tai":  { "text": "よみたい", "ko_pron": "요미타이", "meaning": "읽고 싶다" }
      },
      "example": { "text": "えほんを よみます。", "ko_pron": "에혼오 요미마스.", "meaning": "그림책을 읽어요." }
    },
    {
      "id": "asobu",
      "group": "g1",
      "text": "あそぶ",
      "kanji": "遊ぶ",
      "ko_pron": "아소부",
      "meaning": "놀다",
      "note": "ぶ로 끝나는 1형: て형은 んで",
      "forms": {
        "masu": { "text": "あそびます", "ko_pron": "아소비마스", "meaning": "놉니다" },
        "te":   { "text": "あそんで",   "ko_pron": "아손데",     "meaning": "놀고 / 놀아서" },
        "ta":   { "text": "あそんだ",   "ko_pron": "아손다",     "meaning": "놀았다" },
        "nai":  { "text": "あそばない", "ko_pron": "아소바나이", "meaning": "안 논다" },
        "tai":  { "text": "あそびたい", "ko_pron": "아소비타이", "meaning": "놀고 싶다" }
      },
      "example": { "text": "ともだちと あそびます。", "ko_pron": "토모다치토 아소비마스.", "meaning": "친구랑 놀아요." }
    },
    {
      "id": "kaku",
      "group": "g1",
      "text": "かく",
      "kanji": "書く",
      "ko_pron": "카쿠",
      "meaning": "쓰다",
      "note": "く로 끝나는 1형: て형은 いて",
      "forms": {
        "masu": { "text": "かきます", "ko_pron": "카키마스", "meaning": "씁니다" },
        "te":   { "text": "かいて",   "ko_pron": "카이테",   "meaning": "쓰고 / 써서" },
        "ta":   { "text": "かいた",   "ko_pron": "카이타",   "meaning": "썼다" },
        "nai":  { "text": "かかない", "ko_pron": "카카나이", "meaning": "안 쓴다" },
        "tai":  { "text": "かきたい", "ko_pron": "카키타이", "meaning": "쓰고 싶다" }
      },
      "example": { "text": "なまえを かきます。", "ko_pron": "나마에오 카키마스.", "meaning": "이름을 써요." }
    },
    {
      "id": "iku",
      "group": "g1",
      "text": "いく",
      "kanji": "行く",
      "ko_pron": "이쿠",
      "meaning": "가다",
      "note": "예외: く로 끝나지만 て형은 いて가 아니라 いって",
      "forms": {
        "masu": { "text": "いきます", "ko_pron": "이키마스", "meaning": "갑니다" },
        "te":   { "text": "いって",   "ko_pron": "잇테",     "meaning": "가고 / 가서" },
        "ta":   { "text": "いった",   "ko_pron": "잇타",     "meaning": "갔다" },
        "nai":  { "text": "いかない", "ko_pron": "이카나이", "meaning": "안 간다" },
        "tai":  { "text": "いきたい", "ko_pron": "이키타이", "meaning": "가고 싶다" }
      },
      "example": { "text": "がっこうに いきます。", "ko_pron": "각코니 이키마스.", "meaning": "학교에 가요." }
    },
    {
      "id": "oyogu",
      "group": "g1",
      "text": "およぐ",
      "kanji": "泳ぐ",
      "ko_pron": "오요구",
      "meaning": "헤엄치다",
      "note": "ぐ로 끝나는 1형: て형은 いで",
      "forms": {
        "masu": { "text": "およぎます", "ko_pron": "오요기마스", "meaning": "헤엄칩니다" },
        "te":   { "text": "およいで",   "ko_pron": "오요이데",   "meaning": "헤엄치고 / 헤엄쳐서" },
        "ta":   { "text": "およいだ",   "ko_pron": "오요이다",   "meaning": "헤엄쳤다" },
        "nai":  { "text": "およがない", "ko_pron": "오요가나이", "meaning": "안 헤엄친다" },
        "tai":  { "text": "およぎたい", "ko_pron": "오요기타이", "meaning": "헤엄치고 싶다" }
      },
      "example": { "text": "うみで およぎたい。", "ko_pron": "우미데 오요기타이.", "meaning": "바다에서 헤엄치고 싶어." }
    },
    {
      "id": "hanasu",
      "group": "g1",
      "text": "はなす",
      "kanji": "話す",
      "ko_pron": "하나스",
      "meaning": "말하다",
      "note": "す로 끝나는 1형: て형은 して",
      "forms": {
        "masu": { "text": "はなします", "ko_pron": "하나시마스", "meaning": "말합니다" },
        "te":   { "text": "はなして",   "ko_pron": "하나시테",   "meaning": "말하고 / 말해서" },
        "ta":   { "text": "はなした",   "ko_pron": "하나시타",   "meaning": "말했다" },
        "nai":  { "text": "はなさない", "ko_pron": "하나사나이", "meaning": "말 안 한다" },
        "tai":  { "text": "はなしたい", "ko_pron": "하나시타이", "meaning": "말하고 싶다" }
      },
      "example": { "text": "にほんごで はなします。", "ko_pron": "니혼고데 하나시마스.", "meaning": "일본어로 말해요." }
    },
    {
      "id": "taberu",
      "group": "g2",
      "text": "たべる",
      "kanji": "食べる",
      "ko_pron": "타베루",
      "meaning": "먹다",
      "note": "2형: る를 떼고 붙이면 끝",
      "forms": {
        "masu": { "text": "たべます", "ko_pron": "타베마스", "meaning": "먹습니다" },
        "te":   { "text": "たべて",   "ko_pron": "타베테",   "meaning": "먹고 / 먹어서" },
        "ta":   { "text": "たべた",   "ko_pron": "타베타",   "meaning": "먹었다" },
        "nai":  { "text": "たべない", "ko_pron": "타베나이", "meaning": "안 먹는다" },
        "tai":  { "text": "たべたい", "ko_pron": "타베타이", "meaning": "먹고 싶다" }
      },
      "example": { "text": "りんごを たべます。", "ko_pron": "링고오 타베마스.", "meaning": "사과를 먹어요." }
    },
    {
      "id": "miru",
      "group": "g2",
      "text": "みる",
      "kanji": "見る",
      "ko_pron": "미루",
      "meaning": "보다",
      "note": "2형: る를 떼고 붙이면 끝",
      "forms": {
        "masu": { "text": "みます", "ko_pron": "미마스", "meaning": "봅니다" },
        "te":   { "text": "みて",   "ko_pron": "미테",   "meaning": "보고 / 봐서" },
        "ta":   { "text": "みた",   "ko_pron": "미타",   "meaning": "봤다" },
        "nai":  { "text": "みない", "ko_pron": "미나이", "meaning": "안 본다" },
        "tai":  { "text": "みたい", "ko_pron": "미타이", "meaning": "보고 싶다" }
      },
      "example": { "text": "テレビを みます。", "ko_pron": "테레비오 미마스.", "meaning": "텔레비전을 봐요." }
    },
    {
      "id": "neru",
      "group": "g2",
      "text": "ねる",
      "kanji": "寝る",
      "ko_pron": "네루",
      "meaning": "자다",
      "note": "2형: る를 떼고 붙이면 끝",
      "forms": {
        "masu": { "text": "ねます", "ko_pron": "네마스", "meaning": "잡니다" },
        "te":   { "text": "ねて",   "ko_pron": "네테",   "meaning": "자고 / 자서" },
        "ta":   { "text": "ねた",   "ko_pron": "네타",   "meaning": "잤다" },
        "nai":  { "text": "ねない", "ko_pron": "네나이", "meaning": "안 잔다" },
        "tai":  { "text": "ねたい", "ko_pron": "네타이", "meaning": "자고 싶다" }
      },
      "example": { "text": "はやく ねます。", "ko_pron": "하야쿠 네마스.", "meaning": "일찍 자요." }
    },
    {
      "id": "suru",
      "group": "g3",
      "text": "する",
      "kanji": null,
      "ko_pron": "스루",
      "meaning": "하다",
      "note": "불규칙: 모양이 し로 바뀜 (보통 한자로 쓰지 않음)",
      "forms": {
        "masu": { "text": "します", "ko_pron": "시마스", "meaning": "합니다" },
        "te":   { "text": "して",   "ko_pron": "시테",   "meaning": "하고 / 해서" },
        "ta":   { "text": "した",   "ko_pron": "시타",   "meaning": "했다" },
        "nai":  { "text": "しない", "ko_pron": "시나이", "meaning": "안 한다" },
        "tai":  { "text": "したい", "ko_pron": "시타이", "meaning": "하고 싶다" }
      },
      "example": { "text": "サッカーを します。", "ko_pron": "삿카오 시마스.", "meaning": "축구를 해요." }
    },
    {
      "id": "kuru",
      "group": "g3",
      "text": "くる",
      "kanji": "来る",
      "ko_pron": "쿠루",
      "meaning": "오다",
      "note": "불규칙: き로 바뀌지만 ない형만 こ",
      "forms": {
        "masu": { "text": "きます", "ko_pron": "키마스", "meaning": "옵니다" },
        "te":   { "text": "きて",   "ko_pron": "키테",   "meaning": "오고 / 와서" },
        "ta":   { "text": "きた",   "ko_pron": "키타",   "meaning": "왔다" },
        "nai":  { "text": "こない", "ko_pron": "코나이", "meaning": "안 온다" },
        "tai":  { "text": "きたい", "ko_pron": "키타이", "meaning": "오고 싶다" }
      },
      "example": { "text": "ここに きて。", "ko_pron": "코코니 키테.", "meaning": "여기로 와." }
    }
  ]
}
